# Google AI (Nano Banana Pro / Gemini)
GOOGLE_AI_API_KEY=your-google-ai-key

# OpenAI (Whisper)
OPENAI_API_KEY=sk-xxx

# Pinterest
PINTEREST_ACCESS_TOKEN=your-pinterest-token

# LINE
LINE_CHANNEL_ACCESS_TOKEN=your-line-token
